generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

model Post {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  subtitle    String     @default("")
  author      String     @default("Dignity Trading")
  category    String     @default("Education")
  coverUrl    String     @default("")
  tags        String     @default("")
  contentHtml String     @default("")
  contentText String     @default("")
  reads       Int        @default(0)
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
}

/// CMS-backed copy for public marketing pages (e.g. free Forex course).
model PublicCourse {
  id               String   @id @default(cuid())
  key              String   @unique
  eyebrow          String   @default("")
  title            String   @default("")
  descriptionEn1   String   @default("") @db.Text
  descriptionEn2   String   @default("") @db.Text
  descriptionMy1   String   @default("") @db.Text
  descriptionMy2   String   @default("") @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  lessons PublicCourseLesson[]
}

model PublicCourseLesson {
  id        String       @id @default(cuid())
  courseId  String
  course    PublicCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sortOrder Int          @default(0)
  videoUrl  String

  @@index([courseId, sortOrder])
}

model AdminCredential {
  id           String   @id @default("default")
  email        String   @unique
  passwordHash String
  updatedAt    DateTime @updatedAt
}

model PageView {
  id        String   @id @default(cuid())
  day       DateTime @db.Date
  ipHash    String
  country   String   @default("XX")
  path      String   @default("/")
  createdAt DateTime @default(now())

  @@unique([day, ipHash, path])
  @@index([day])
  @@index([country, day])
}
